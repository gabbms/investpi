# Banco PostgreSQL do projeto (contêiner Docker, porta 5433)
DATABASE_URL=postgresql+psycopg://asg:asg@localhost:5433/asg
TEST_DATABASE_URL=postgresql+psycopg://asg:asg@localhost:5433/asg_test

# Segredo para assinar os tokens de login (troque em produção)
JWT_SEGREDO=troque-este-segredo-por-um-texto-longo-e-aleatorio
JWT_HORAS=8

# Usuários de demonstração criados por "python -m app.cli inicializar"
ADMIN_EMAIL=admin@asg.local
ADMIN_SENHA=Admin@2026
LEITOR_EMAIL=leitor@asg.local
LEITOR_SENHA=Leitor@2026
